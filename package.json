{
  "name": "beckwourth-ride-3d",
  "private": true,
  "description": "A watercolor 3D terrain map of BKXC's Beckwourth Peak ride",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/build-standalone.mjs",
    "preview": "vite preview",
    "data": "node scripts/build-data.mjs",
    "data:ride": "node scripts/build-beckwourth.mjs",
    "social": "node scripts/social-images.mjs",
    "film": "node scripts/film.mjs"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.186.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
